# Dependencies
node_modules/

# Build output and tool caches (Vite / TypeScript)
/dist/
.vite/
.vite-temp/
*.tsbuildinfo
.cache/

# Test output (Playwright / coverage)
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
/coverage/

# Local environment variables; keep shareable templates
.env
.env.*
!.env.example
!.env.*.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local review artifacts
.impeccable/review/

# Local patch exports and merge leftovers
/*.patch
/*.diff
*.orig
*.rej

# Temporary files
*.tmp
*.temp
*.bak

# Editor and operating-system files
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
